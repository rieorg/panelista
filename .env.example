# Local dev against the Firebase emulators. Copy to .env.local, then run
# `npm run emulators` in one terminal and `npm run dev` in another.
# No real Firebase project, Turnstile or service account needed.
NEXT_PUBLIC_EMULATORS=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-panelista
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-panelista.firebaseapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# File uploads (verification proofs) need the Cloudflare Worker, which does not run locally yet.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production only (maintainers, set in Vercel): real project values plus
# FIREBASE_AUTH_HOST, NEXT_PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET and
# FIREBASE_SERVICE_ACCOUNT_B64 (base64 of the admin service-account JSON).
# Email notifications: a Gmail address and an app password made on it (leave
# empty locally and no mail is sent). CRON_SECRET must match the Worker secret.
SMTP_USER=
SMTP_PASSWORD=
CRON_SECRET=
