{
  "name": "panelista",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "test": "node --import ./tests/hooks.mjs --test tests/*.test.ts",
    "test:emu": "npx -y firebase-tools@15 emulators:exec --config firebase.test.json --only auth,firestore --project demo-panelista-test \"node --import ./tests/hooks.mjs --test --test-concurrency=1 tests/emu/*.test.ts\"",
    "test:worker": "node --import ./tests/hooks.mjs --test tests/worker/*.test.ts",
    "typegen": "next typegen",
    "emulators": "npx -y firebase-tools@15 emulators:start --project demo-panelista"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "jwks-rsa": "^3.2.0"
  }
}
